#!/usr/bin/env bash
# Shared, version-controlled pre-push hook.
# Enable it once per clone:  git config core.hooksPath .githooks
# (or run ./scripts/setup-hooks.sh). See .githooks/README.md.
set -e

echo "🔍 [Pre-Push] Running format and build checks..."

# 1. Check Go formatting
echo "🐹 Checking Go formatting..."
unformatted="$(gofmt -l cmd internal)"
if [ -n "$unformatted" ]; then
    echo "❌ Go code is not formatted:"; echo "$unformatted"
    echo "Run 'gofmt -w cmd internal' (or 'go fmt ./...')."
    exit 1
fi

# 2. Vet
echo "🐹 Running go vet..."
go vet ./... || {
    echo "❌ go vet failed."
    exit 1
}

# 3. Test
echo "🐹 Running Go tests..."
go test ./... || {
    echo "❌ Go tests failed."
    exit 1
}

# 4. Check Frontend build
echo "⚡ Checking Frontend build..."
(cd frontend && npm run build) || {
    echo "❌ Frontend build failed."
    exit 1
}

echo "✅ All checks passed! Proceeding with git push."
