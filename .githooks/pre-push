#!/usr/bin/env bash
# Shared, version-controlled pre-push hook.
# Enable it once per clone:  git config core.hooksPath .githooks
# (or run ./scripts/setup-hooks.sh). See .githooks/README.md.
set -e

echo "🔍 [Pre-Push] Running format and build checks..."

# 1. Check Rust formatting
echo "🦀 Checking Rust formatting..."
cargo fmt --all -- --check || {
    echo "❌ Rust code is not formatted. Run 'cargo fmt --all' first."
    exit 1
}

# 2. Check Rust workspace
echo "🦀 Checking Rust workspace (clippy)..."
cargo clippy --workspace --all-targets -- -D warnings || {
    echo "❌ Clippy checks failed."
    exit 1
}

# 3. Test Rust workspace
echo "🦀 Running Rust tests..."
cargo test --workspace --all-targets --quiet || {
    echo "❌ Rust tests failed."
    exit 1
}

# 4. Check Frontend build
echo "⚡ Checking Frontend build..."
(cd frontend && npm run build) || {
    echo "❌ Frontend build failed."
    exit 1
}

echo "✅ All checks passed! Proceeding with git push."
